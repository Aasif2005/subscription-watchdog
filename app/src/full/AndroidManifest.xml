<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only this flavor reads SMS; the `play` flavor declares none of it. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Read past bank SMS once to find existing mandates and notices; everything stays on the device. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Pick up new payment SMS as they arrive. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application>
        <receiver
            android:name=".data.sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
